<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>OfficeVbaSigner</AssemblyName>
    <RootNamespace>OfficeVbaSigner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.CodeSigning.Sdk" Version="[0.1.164]" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="*" />
  </ItemGroup>

</Project>
